{
  "name": "arcada-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/serve.mts --watch",
    "build": "bun scripts/static-build.mts",
    "preview": "bun scripts/serve.mts",
    "check": "bun run lint && bun run check:types && bun run check:scripts",
    "check:scripts": "bun --bun tsc --project scripts/tsconfig.json --noEmit",
    "check:watch": "bun --bun tsc --noEmit --watch",
    "test": "bun run build && bun --bun playwright test",
    "deploy:setup": "bun scripts/run.ts setup-deploy",
    "deploy": "bun scripts/run.ts retry-deploy",
    "lint": "bun run lint:js && bun run lint:w3c",
    "lint:js": "bun --bun oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:w3c": "bun run build && bun scripts/validate-w3c.ts",
    "lint:html": "bun run build && bun scripts/validate-w3c.ts html",
    "lint:css": "bun run build && bun scripts/validate-w3c.ts css",
    "lint:fix": "bun run lint:js --fix && bun run lint:w3c",
    "test:validators": "bun test scripts/w3c.test.ts",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "test:themes": "bun test --tsconfig-override ./tsconfig.paths.json src/lib/theme/theme-schema.test.ts",
    "check:types": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@lit-labs/ssr-client": "^1.1.8",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
